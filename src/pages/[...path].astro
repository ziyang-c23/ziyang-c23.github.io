---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { labels, localizedPath } from '../lib/i18n';
import { publishedEntries, entryPath, formatDate } from '../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const section of ['blogs', 'projects'] as const) {
    const entries = await publishedEntries(section);
    for (const entry of entries) {
      const other = entries.find(candidate => candidate.data.translationKey === entry.data.translationKey && candidate.data.locale !== entry.data.locale);
      paths.push({
        params: { path: entryPath(section, entry.data).replace(/^\/|\/$/g, '') },
        props: { entry, section, alternatePath: other ? entryPath(section, other.data) : null },
      });
    }
  }
  return paths;
}
const { entry, section, alternatePath } = Astro.props;
const { Content } = await render(entry);
const { locale } = entry.data;
const l = labels[locale];
---
<Base locale={locale} title={entry.data.title} description={entry.data.description} section={section} alternatePath={alternatePath}>
  <article class="detail-page">
    <a class="back-link" href={localizedPath(locale, section)}>← {l.back} {l[section]}</a>
    <header class="page-heading"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, locale)}</time><h1>{entry.data.title}</h1><p class="page-intro">{entry.data.description}</p></header>
    {entry.data.image && <img class="detail-cover" src={entry.data.image} alt={entry.data.imageAlt} />}
    {entry.data.links.length > 0 && <div class="paper-links detail-links">{entry.data.links.map(link => <a href={link.url}>{link.label} ↗</a>)}</div>}
    <div class="prose"><Content /></div>
  </article>
</Base>
